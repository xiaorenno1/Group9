      propertyPath: cnText
      value: "\u201C\u6211\u7231\u4F60\uFF0C\u50CF\u6211\u8DF3\u5F97\u8FD9\u4E48\u9AD8\uFF01\u201D\u5C0F\u7EB3\u7279\u5E03\u6717\u5154\u7B11\u7740\u8BF4\uFF0C\u4E0A\u4E0A\u4E0B\u4E0B\u5730\u8E66\u8DF3\u7740\u3002\r\n\u201C\u53EF\u662F\u6211\u7231\u4F60\uFF0C\u50CF\u6211\u8DF3\u5F97\u8FD9\u4E48\u9AD8\uFF0C\u201D\u5927\u7EB3\u7279\u5E03\u6717\u5154\u5FAE\u7B11\u7740\u8BF4\u3002"
